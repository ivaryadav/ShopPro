# Z-SUPERADMIN platform environment — copy to platform/.env and fill in.
# Completely separate from server/.env (ShopERP) — never share a secret
# between the two.

# Required — signs Z-SUPERADMIN's own JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
PLATFORM_JWT_SECRET=CHANGE_ME_64_CHAR_RANDOM_HEX_STRING

# Optional — defaults shown
PLATFORM_PORT=4100
PLATFORM_DB_PATH=./platform.db
PLATFORM_ALLOWED_ORIGINS=

# Optional — SMTP for platform-triggered emails (welcome/renewal/etc.).
# If left unset, emails are logged, not sent (see platformMailerService.js).
PLATFORM_SMTP_HOST=
PLATFORM_SMTP_PORT=587
PLATFORM_SMTP_USER=
PLATFORM_SMTP_PASS=
PLATFORM_SMTP_FROM=Z-SUPERADMIN <no-reply@zmaxlab.com>

# Optional — the ShopERP adapter (src/adapters/shoperpAdapter.js). Unset =
# the adapter reports isConfigured():false and ShopERP simply doesn't
# appear anywhere in Z-SUPERADMIN (Organizations, License Center, Reports,
# System Health) rather than erroring at boot. SHOPERP_ADMIN_PASSWORD is
# used ONLY to authenticate the adapter's own calls against ShopERP's
# existing admin API — never stored, never used to create or change any
# ShopERP Super Admin account.
SHOPERP_BASE_URL=
SHOPERP_ADMIN_PASSWORD=

# Optional — webhook delivery data lifecycle (Phase 5F). Defaults shown.
# EVENT_RETENTION_DAYS: how long platform_events rows are kept before the
# Event Retention Job purges them. WEBHOOK_DEAD_LETTER_RETENTION_DAYS: same,
# for dead-lettered webhook deliveries.
EVENT_RETENTION_DAYS=180
WEBHOOK_DEAD_LETTER_RETENTION_DAYS=90

# Optional — RC1 SSRF hardening escape hatch. Leave unset in production.
# When 'true', webhook endpoint URLs may point at localhost/private/
# link-local addresses — set ONLY by the automated test harness
# (test/testServer.js) so its disposable local test sink server works.
PLATFORM_ALLOW_PRIVATE_WEBHOOKS=
